{
  "name": "bs-odm",
  "version": "2.0.0",
  "description": "Object oriented Mongodb Mapper",
  "type": "module",
  "main": "./lib/src/index.js",
  "types": "./lib/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/src/index.d.ts",
      "default": "./lib/src/index.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=26"
  },
  "author": {
    "name": "Nico Beyer",
    "email": "nico@beyer-soehne.de"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/NicoBeyer/bs-odm.git"
  },
  "dependencies": {
    "lodash": "^4.18.1"
  },
  "peerDependencies": {
    "mongodb": "^7.9.1"
  },
  "devDependencies": {
    "@types/chai": "^5.2.3",
    "@types/chai-as-promised": "^8.0.2",
    "@types/lodash": "^4.17.27",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.6",
    "chai": "^6.3.0",
    "chai-as-promised": "^8.0.2",
    "mocha": "^12.0.3",
    "mongodb": "^7.9.1",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "glob": "^14.0.6",
    "minimatch": "^11.0.9"
  },
  "scripts": {
    "build": "tsc",
    "test": "mocha --enable-source-maps lib/test/",
    "ncu": "ncu -u -x chai,chai-as-promised,aws-sdk-client-mock,@nbeyer/pms-serviceinstance,@nbeyer/pms-test-helper  && ncu -u -f chai-as-promised,chai,aws-sdk-client-mock,eslint -t minor && ncu -u -f @nbeyer/pms-serviceinstance,@nbeyer/pms-test-helper -t patch && npm i && npm audit fix"
  }
}
